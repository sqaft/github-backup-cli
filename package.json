{
  "name": "@sqaft/github-backup-cli",
  "version": "0.1.0",
  "description": "Back up GitHub repositories (with wikis and LFS) to local disk and S3-compatible storage as git bundle snapshots.",
  "keywords": [
    "github",
    "backup",
    "git",
    "git-bundle",
    "git-lfs",
    "wiki",
    "s3",
    "r2",
    "cli"
  ],
  "homepage": "https://github.com/sqaft/github-backup-cli#readme",
  "bugs": {
    "url": "https://github.com/sqaft/github-backup-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sqaft/github-backup-cli.git"
  },
  "license": "MIT",
  "author": "sqaft",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "github-backup": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "config.example.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "commander": "^15.0.0",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
